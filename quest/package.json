{
  "name": "bloodlines-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "validate:maps": "node --experimental-strip-types tools/validate-maps.ts",
    "smoke": "node --experimental-strip-types tests/smoke.mjs",
    "maps:build": "node --experimental-strip-types tools/build-maps.ts",
    "audit:lang": "node --experimental-strip-types tools/audit-lang.ts",
    "route:expand": "node --experimental-strip-types tools/expand-route.ts",
    "icons": "node --experimental-strip-types tools/make-icons.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
